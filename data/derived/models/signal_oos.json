{
 "protocol": {
  "declaration": "retrospective validation with temporal separation: protocol and split declared 2026-11-06 over a history that earlier exploratory analyses of this project had already used; the code enforces calibration/evaluation separation but cannot establish that the evaluation period was unknown when the protocol was designed",
  "prospective": {
   "frozen_on": "2026-11-06",
   "rule": "this protocol is not re-tuned; a prospective result uses only data published after 2026-11-06",
   "intents_and_qaa": "not evaluable under the declared calibration end; their prospective plan is persisted once in data/prospective/oos_freeze.json (near-thesis oos-freeze) with the effective freeze date, the hash of the calibration rows, the learned sign, the family and the fixed evaluation weeks; later builds load that file and never recompute it, so adding history cannot move the cutoff or the scoring dates, and once the 20 evaluation targets are realized the same build scores the test under the frozen sign",
   "persisted_plan": "data/prospective/oos_freeze.json"
  },
  "hypothesis": "a four-week rise in usage is associated with the subsequent h-week NEAR log return in excess of the benchmark, with the sign fixed in calibration",
  "signal_transform": "weekly means of the daily series; log of the trailing four-week mean, differenced by four weeks; QAA only from the frozen past-only model, available on the first day of the following month",
  "target": "forward h-week log return of NEAR minus the same return of the benchmark (BTC or ETH)",
  "horizons_weeks": [
   4,
   12
  ],
  "benchmarks": [
   "btc",
   "eth"
  ],
  "calibration_end": "2025-06-29",
  "purge": "evaluation starts h weeks after the calibration end so that no calibration target overlaps an evaluation week",
  "fixed_rule": "the sign of the calibration Spearman IC is frozen; success requires the evaluation IC under that sign to be positive with the Bonferroni-adjusted (24 tests) circular block-bootstrap 95% interval above zero; the unadjusted interval is reported as exploratory only",
  "benchmark_predictor_treatment": "the two naive predictors are not members of the 24-test family and are not tested for passing; their evaluation IC is a comparison level that a usage metric should exceed to add information beyond persistence and the market",
  "walk_forward": "expanding window: each evaluation week re-estimates the sign on targets already realized at that week (purged by h) and predicts the direction of the next target; hit rate reported",
  "family": "6 metrics x 2 horizons x 2 benchmarks = 24 declared tests; Bonferroni intervals reported",
  "benchmark_predictors": {
   "near_momentum": "trailing four-week NEAR excess log return (persistence)",
   "btc_trend": "trailing four-week BTC log return (relation to the market benchmark)"
  },
  "minimum_rows": {
   "calibration": 30,
   "evaluation": 20
  },
  "limitations": [
   "NearBlocks and DefiLlama series are current snapshots: historical revisions and publication lags are not reconstructed, except QAA availability dates",
   "overlapping weekly targets; block bootstrap approximates dependence",
   "descriptive association only: no costs, liquidity or execution rules, so no trading claim"
  ]
 },
