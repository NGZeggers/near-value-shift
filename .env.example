# Optional: Google Cloud project for BigQuery (a free BigQuery sandbox project works, no credit card).
GOOGLE_CLOUD_PROJECT=
# Hard cap for a single BigQuery query, in GB scanned. The pipeline dry-runs first and refuses above this.
BQ_MAX_GB_PER_QUERY=120
# Additional ceiling per invocation; this does not track the monthly Google quota.
BQ_MAX_GB_PER_RUN=300
BQ_MAX_STALENESS_DAYS=7
# Reserved: Explorer cross-check is not implemented; the current pipeline does not use this token.
INTENTS_EXPLORER_JWT=

# Optional: on-chain publication of the index to NEAR Social (stretch goal). Never committed. Testnet by default.
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
